# Konfigurasi Otomatisasi Blockchain TrashQuest
# Salin file ini menjadi .env jika ingin menggunakan wallet dan API key pribadi:
# copy .env.example .env

# Port server REST API (default: 3000)
PORT=3000

# RPC URL Ethereum Sepolia (Gratis public node atau gunakan Alchemy/Infura)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Alamat Smart Contract TrashQuest di Sepolia Etherscan
CONTRACT_ADDRESS=0xc4b19b885b4426974701774741F64E67977C6B17

# Private key wallet admin / relayer yang memiliki Sepolia ETH gratis
# (Dapatkan gratis di faucet: https://cloud.google.com/application/web3/faucet/ethereum/sepolia)
ADMIN_PRIVATE_KEY=29e0a1db9e264d9cec18bedbdfd7c78d8596018e2c3504e98aa6c693f059b416
